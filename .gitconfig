[user]
	name = EdgeLordKirito
	email = Leiteritz.till@gmail.com
[core]
	autocrlf = input
	eol = lf
[alias]
	graph = log --graph --oneline --decorate --all
	sweep-local = "!f() { auto_delete=false; if [[ \"$1\" == \"--auto\" ]]; then auto_delete=true; fi; git fetch --prune; delete_branch() { git branch -d \"$1\" > /dev/null 2>&1 || true; echo \"Deleted $1\"; }; git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | while IFS= read -r line; do branch=\"${line%% *}\"; upstream=\"${line#* }\"; if [[ \"$upstream\" != \"[gone]\" ]]; then continue; fi; echo \"Found deleted remote branch: $branch\"; if [ \"$auto_delete\" = true ]; then delete_branch \"$branch\"; else read -p \"Delete branch '$branch'? [y/N] \" confirm; if [[ \"$confirm\" =~ ^[Yy]$ ]]; then delete_branch \"$branch\"; else echo \"Skipped $branch\"; fi; fi; done; }; f"
