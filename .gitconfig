[user]
	name = EdgeLordKirito
	email = Leiteritz.till@gmail.com
[core]
	autocrlf = input
	eol = lf
[alias]
	graph = log --graph --oneline --decorate --all
	sweep-local = "!f() { auto_delete=false; if [[ \"$1\" == \"--auto\" ]]; then auto_delete=true; fi; git fetch --prune; delete_branch() { branch=\"$1\"; if git branch -d \"$branch\"; then echo \"Deleted $branch\" >&2; else echo \"Skipped $branch\" >&2; fi; }; git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | while IFS= read -r line; do branch=\"${line%% *}\"; upstream=\"${line#* }\"; if [[ \"$upstream\" != \"[gone]\" ]]; then continue; fi; echo \"Found deleted remote branch: $branch\" >&2; if [ \"$auto_delete\" = true ]; then delete_branch \"$branch\"; else read -p \"Delete branch '$branch'? [y/N] \" confirm </dev/tty; if [[ \"$confirm\" =~ ^[Yy]$ ]]; then delete_branch \"$branch\"; else echo \"Skipped $branch\" >&2; fi; fi; done; }; f"
